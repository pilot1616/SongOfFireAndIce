[application]
config/name="Ember & Tide: Mosslight"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.063, 0.09, 1)

[input]
ember_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
ember_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
ember_jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
tide_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194311)]}
tide_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194313)]}
tide_jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194320)]}
reset={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
debug_next={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":78)]}
debug_prev={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":80)]}
debug_0={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":48)]}
debug_1={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":49)]}
